@import url('https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,600,700');
body {margin:0; padding:0;font-family: 'Source Sans Pro',
 sans-serif !important; line-height:normal; width:100%;color:#4a4a4a;
 position: relative; font-size: 14px;background-image: url(../images/bg.jpg);
 background-repeat: repeat;background-attachment: fixed;
}
html {width:100%;}
textarea{font-family: arial;}
input[type="text"],input[type="submit"],input[type="button"],input[type="password"], textarea {border-radius:0; -webkit-appearance:none; -moz-appearance:none;}
* {box-sizing:border-box; -webkit-box-sizing:border-box;
 -moz-box-sizing:border-box; outline: none;padding: 0;}
a{text-decoration: none; color: #1c267a;cursor: pointer;}
ul{list-style: none;}
a:hover{text-decoration: underline;}

header {max-width: 1024px;
    margin: auto;
    padding: 10px 0;
    width: 100%;
    overflow: hidden;
}
.container.main {
    padding-top: 61px;
}
header#header {
    max-width: inherit;
    margin: auto;
    position: fixed;
    z-index: 99999;
    top: 0;
    overflow: inherit;
    width: 100%;
    background-color: #fff;
    left: 0;
    padding: 10px 0;
    margin-bottom: 0;
    box-shadow: 0px 0px 10px 0px #ccc;
}
.container {
  margin-right: auto;
  margin-left: auto;
  max-width: 1170px;
  padding-left: 6px;
  padding-right: 6px; }

.ftr_container{max-width: 900px; margin: auto;}


  .container:before, .container:after {
    content: " ";
    display: table; }
  .container:after {
    clear: both; }
  @media (min-width: 768px) {
    .container {
      width: 732px; }
}
  @media (min-width: 992px) {
    .container {
      width: 952px; } }
  @media (min-width: 1200px) {
    .container {
      width: 1152px; } }
.logo {
    float: left;
}

.logo a {
    margin-top: 8px;
    display: inline-block;
    margin-bottom: 5px; 
}
.header_right {
    float: right;
    width: 70%;
}
.logo img {
    max-width: 150px;
}
a.login-button {
    background: #fff;
    border-radius: 3px;
    border: 1px solid #ccc;
    color: #999;
    float: right;
    margin-top:4px;
    font-size: 12px;
    padding: 7px 20px;
    text-decoration: none;
}	

.banner{width: 100%;}
.teaser-header {
    background: url(../images/banner.jpg) no-repeat right top #fff;
    background-size: 1130px 390px;
    height: 400px;
    position: relative;
    width: 100%;
    margin: auto;
    float: left;
}
.teaser-header:after {
    position: absolute;
    content: '';
    width: 61%;
    right: 0;
    top: 0;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
}
.layered-bg {
    background: url(../images/banner_frm_bg.png) -130px top no-repeat transparent;
    height: 100%;
    margin: 0 auto;
    z-index: 1;
    overflow: hidden;
    position: relative;
    width: 100%;
}
.communication-container-b {
    top: 50%;
    padding: 0 20px;
    position: absolute;
    right: 0;
    transform: translateY(-50%);
    width: 460px;
}
.form_cont {
    padding: 50px 10px 10px;
    position: absolute;
    left: 90px;
    opacity: 1;
    right: auto;
    top: 0;
    width: 350px;
    z-index: auto;
}

.form_cont .headline {
    color: white;
    font-size: 17px;
    line-height: 24px;
    padding-bottom: 10px;
}
.communication-container-b h1 {
    color: #fff;  
    font-size: 24px;
    line-height: 28px;
    text-shadow: 2px 2px 5px #2b2b2b;
    margin-bottom: 0px;  
    background-color: rgba(0,0,0,0.4);
    padding: 10px;
    border-left: 4px solid #fff;
    font-weight: 500;
}
.communication-container-b p {
    float: left;color: white;
font-size: 16px;
line-height: 24px;
text-shadow: 2px 2px 5px #2b2b2b;
    margin-top: 7px;
}
.mini-signup-hide form input{    box-sizing: border-box;
    display: block;
    margin: 0;
    min-height: 0;
    outline: 0;
    padding: 8px;
    position: relative;
    width: 100% !important;  
    border: 1px solid #FFF;
    box-shadow: none;
    line-height: 14px;margin-bottom: 10px;
}
.frmfldgroup {
    position: relative;
    width: 100%;
}
.frmfldgroup .erorfldcls {
    position: absolute;
    color: #fff;
    top: 0;
    background-color: #000;
    right: 0;
    padding: 2px 5px;
    z-index: 99;
}

.frmfldgroup.terms {
    margin-top: 29px;
}
.frmfldgroup.terms .erorfldcls {
    margin-top: -26px;
}
.t-and-c{color: #ccc;
    font-size: 11px;
    padding: 10px 0;
    display: block;
}
.t-and-c input[type="checkbox"] {
    float: left;
    max-width: 15px;
    margin-top: 0;
    margin-right: 5px;
    text-align: left;
}
span.tandc-text a {
    color: #ccc;
}
.problm {
    color: #ccc;
    font-size: 12px;
}
button.rgstr_button {
    display: block;
    width: 100%;
    margin-top: 0;
    border: 0;
    height: 35px;
    background-color: #ff417d;
    color: #fff;
    outline: none;
    cursor: pointer;
    font-size: 16px;
    text-transform: capitalize;
}
.sbscrib.one a {
    color: #ffba00;
}
button.rgstr_button.one {
    background-color: #ffba00;
}
label.rmmber {
    display: block;
    margin-top: 8px;
    color: #ccc;
    font-size: 13px;
}
label.rmmber input[type="checkbox"] {
    float: left;
    width: 15px !important;
    margin-right: 3px;
    margin-top: 1px;
}
#login label.t-and-c {
    text-align: center;
}
.nav-cont {
        padding-bottom: 20px;
    float: none;
    margin-top: 60px;
    text-align: center;
}
.sbscrib {
    width: 100%;
    float: left;
    text-align: center;
    font-size: 16px;
    margin: 30px 0;
}
.sbscrib a {
    color: #ff417d;
}
.discover {
    width: 100%;
    text-align: center;
    margin-top: 30px;
    color: #212d6e;
    font-weight: 700;
}
.nav-cont .column {
padding: 0 10px;
    padding-top: 0;
    display: inline-table;
    text-align: center;
    max-width: 230px;
    background-color: #fff;
    height: 210px;
    width: 20%;
    box-sizing: border-box;
    border-radius: 4px;
}

.column .icon {
    border: 2px solid #fff;
    border-radius: 50%;
    margin: 0 auto;
    position: relative;
    background-color: #212d6e;
    height: 80px;
    width: 80px;
    margin-top: -40px;
    box-shadow: 2px 2px 18px #a2a2a2;
}
.column .cont h2 {
    font-size: 16px;
    margin: 15px 0 05px;
}
.column .cont p {
    font-size: 13px;
    min-height: 85px;
    margin: 0;
}
[class*='foundation-icon'] {
    display: inline-block;
    font-size: 0;
    font-style: normal;
    font-variant: normal;
    font-weight: 400;
    line-height: 21px;
    text-decoration: inherit;
    text-transform: none;
}
.foundation-icon-navigation-events:before {
    content: "\f144";
}
.column .icon i.fa {
    top: 50%;
    position: absolute;
    left: 50%;
    font-size: 24px;
    color: #fff;
    transform: translateX(-50%) translateY(-50%);
}
.lot {
    width: 100%;
    float: left;
}
.contct_search{margin: 20px 0;
    clear: both;
    background:rgb(226, 226, 226);
    padding: 30px;
    margin-bottom: 0;}
.contct_search form{    background: none;
    margin: 0 auto;
    max-width: 630px;
    position: relative;
    clear: both;
    padding: 0;}
.contct_search form label {
    width: 100%;
    float: left;  
    font-size: 12px;
    margin-bottom: 3px;
}

.contct_search form input{    border-radius: 2px;
    box-shadow: inset 1px 1px 3px 0 #C8C8C8;
    font-size: 14px;
    border-top: 0;
border-left: 0;
    margin: 0;
    border-bottom: solid 1px #ccc;
    padding: 10px 1%;
    width: 45%;
    float: left;
}
.contct_search form input:focus{outline: solid 1px #ff417d;}
.contct_search form button{background-color: #DEDEDE;
    background-image: linear-gradient(to bottom, #eaeaea, #cacaca);
    border-radius: 0;
    height: 37px;
    border: solid 1px #d1d1d1;
    outline: none;
    cursor: pointer;
    margin: 0;
    width: 10%; margin-left: -1px;}
    .contct_search form button:hover {
    background-image: linear-gradient(to bottom, #ff417d, #b9496d);
    color: #fff;
}
.mmbr_directory {
    text-align: center;
    max-width: 625px;
    font-size: 13px;
    margin: 20px auto;
    overflow: hidden;
    margin-bottom: 0;
}
.mmbrof_group_list {
    margin: 0;
    background-color: #fff;
    overflow: hidden;
    float: left;
    padding: 20px;
    width: 100%;
}
.mmbrof_group_list h2 {
    border-bottom: solid 1px #dadada;
    padding-bottom: 10px;
}
.mmbr_directory span {
    float: left;
}

.selct_popup {
    position: fixed;
    top: 0;
    left: 0;
    background-color: rgba(0,0,0,0.5);
    width: 100%;
    display: none;
    height: 100%;
    z-index: 999;
}
.selct_popup .popup_cont {
    width: 300px;
    height: auto;
    overflow: hidden;
    background-color: #fff;
    margin: auto;
    text-align: center;
    padding: 20px;
    border-radius: 4px;
    margin-top: 100px;
}
div#wrapper.active .selct_popup {
    display: block;
}
.popup_cont h4.usrname {
    margin: 0;
}
.popup_cont p{margin: 0;    text-align: left;
    margin-top: 10px;font-size: 13px;}
ul.steps {
    margin-bottom: 0;
    width: 100%;
    float: left;
}
ul.steps li {
    width: 20px;
    height: 20px;
    display: inline-block;
    line-height: 20px;
    background-color: #888;
    color: #fff;
    margin-right: 7px;
}
ul.steps li.active{ background-color: #202d78;}
.cntnt_box {
    float: left;
    width: 100%;
    margin-top: 15px;
}
.cntnt_box .slct_cont {
    width: 100%;
    float: left;
    margin-bottom: 15px;
}
.slct_cont label {
    font-size: 13px;
    text-align: left;
    display: block;
    margin-bottom: 7px;
    color: #000;
}
.slct_cont select {
    width: 100%;
    height: 30px;
    padding-left: 10px;
}
.cntnt_box .svbtn {
    background-color: #202d78;
    border: 0;
    padding: 8px 25px;
    color: #fff;margin-top: 20px;
}

ul.people-directory {
    float: left;
    padding: 0;
    list-style: none;
    margin: 0;
}
ul.people-directory li {
    float: left;
}
ul.people-directory li a {
    font-size: 11px;
    text-decoration: none;
    margin: 0 2px;
    color: #0d385d;
}
ul.people-directory li a:hover{text-decoration: underline;} 

dl.dl_list dt {
    display: inline;
    margin-right: 10px;margin-top: 3px;
    font-size:13px; 
}
dl.dl_list dd {
    display: inline-block;
    margin: 0;
    margin-right: 0;
}
dl.dl_list {
    text-align: center;
    color: #000;
}
dl.dl_list dd a{font-size: 12px;padding-right: 6px; text-decoration: none;
 color: #808080;border-right: solid 1px;}
dl.dl_list dd a:hover{text-decoration: underline;}
dl.dl_list dd:last-child a{border-right: 0;}
.foottr_link {
    margin-bottom: 60px;
}

.copyright_cont{width: 100%; border-top: solid 1px #d1d1d1;
    background-color: #ebebeb; margin-top: 50px;}
.copyright_cont.home p.all_right {
    color: #111;
}
ul.copy_nav {
    text-align: center;
    list-style: none;
    padding: 0;
}
ul.copy_nav li{display: inline-block;}
.all_right{font-size: 11px;text-align: center;margin: 0;
    padding: 0 0 15px;}

.email_banner{background-image: url(../images/e_banner.jpg);height: 600px;
    background-position: 0 0 ;background-size: 100%;position: relative;z-index: 1;}
.email_banner:before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: -1;
    height: 100%;
    content: '';
    background: linear-gradient(to left, rgba(2, 27, 121,0.4), rgba(5, 117, 230,.7) );
}
.email_center{text-align: center;}
.email_center h1{color: #fff;font-size: 25px;margin: auto; max-width: 670px;margin-top: 50px;}
.email_center p{font-size: 18px;color: #fff; text-align: center;}
.email_center img {
    margin-top: 50px;
}
.mail_btn {
    margin-top: 25px;
}
.mail_btn a {
    padding: 10px 15px;
    background: #20267c;
    color: #fff;
    font-size: 14px;
    text-decoration: none;
    margin-top: 55px;
}
span.not_recieved {
    display: block;
    margin-top: 15px;
}
span.not_recieved a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
}
.copyright_cont.email dl.dl_list dd a{font-size: 16px;}

.copyright_cont.email dl.dl_list dd:last-child a {
    color: #000;
}
.copyright_cont.email .all_right {
    font-size: 16px;
}
/* home page */


header#header .logo img {
    width: 150px;
}

.hdr_search {
    float: right;
    width: auto;
}
.mainsearch {
    position: relative;
    width: 330px;
    float: left;
    margin-top: 5px;

}
.cmmnt-btn {
    background-color: #fe1c69;
    border: 0;
    color: #fff;
    margin-top: 10px;border-radius: 4px;
    padding: 8px 20px;
}
.mainsearch input.text {
    width: 330px;
    height: 35px;
    border: solid 1px #e7e7e7;
    padding-left: 10px;
    border-radius: 3px;
}
button.search_btn {
    position: absolute;
    height: 35px;
    right: 0;
    width: 45px;
    font-size: 16px;
    transition: 300ms;
    overflow: hidden;
    cursor: pointer;
    z-index: 2;border-radius: 0 3px 3px 0;
    background-color: inherit;
    border: 0;
}
.search_btn:hover{background: #202d78; color: #fff;}
.search_btn:hover i{color: #fff;}
.search_btn i{position: relative; color: #696868;z-index: 99;}
/*button.search_btn:hover{background-color: #202d78; border-radius: 0 3px 3px 0;
    color: #fff;}*/
.search_drop {
    float:left;margin-left: 15px;
    margin-top: 9px;
    position: relative;padding-bottom: 15px;
}
span.drop_trigger{display: block;position: relative;cursor: pointer;}
span.drop_trigger i.fa.fa-chevron-down {
    font-size: 14px;
}   
ul.drop_cont {
    position: absolute;
    list-style: none;
    right: 0;
    box-shadow:0 0 8px rgba(0,0,0,0.5);
    opacity: 0;top: 50px;
    left: -10px;
    display: none;
    border-radius: 5px;
    transition: 1s ease-in-out;
    width: 170px;
    margin: 0;
}
ul.drop_cont:before {
    position: absolute;
    content: '';
    width: 0;
    height: 0;
    top: -9px;
    border-bottom: solid 10px #202d78;
    border-right: solid 10px transparent;
    border-left: solid 10px transparent;
    left: 50%;
    transform: translateX(-50%);
}
ul.drop_cont li {
    background: #202d78;
    height: 30px;
    width: 170px;
    line-height: 30px;
    padding-left: 15px;
    border-bottom: solid 1px rgba(255, 255, 255,0.6);
}
ul.drop_cont li:first-child {
    font-size: 12px;border-radius: 5px 5px 0 0;
    color: #fff;
}
ul.drop_cont li:last-child,ul.setting_menu li:last-child a{border-radius: 0 0 3px 3px;border: 0;}
ul.drop_cont li a {
    color: #fff;
    display: block;
    text-transform: capitalize;
    font-size: 14px;
}
ul.setting_menu li:first-child a{border-radius: 3px 3px 0 0;}
ul.setting_menu li a {
    display: block;
    padding: 9px;
}
.search_drop:hover ul.drop_cont{opacity: 1;top: 33px;display: block;}
.find_btn {
    float: left;
    display: block;
    margin-top: 0;
    margin-left: 15px;
}
.find_btn a.frndr{text-decoration: none; display: block;}
.find_btn a.frndr i.fa {
    text-transform: uppercase;
    display: block;
    width: 30px;
    position: relative;
    margin: auto;
    height: 30px;
    line-height: 30px;
    text-align: center;
    font-size: 20px;
        color: #1c267a;
}
.find_btn a.frndr i.fa img{width: 20px;}
.frnd-request {
    position: relative;
    top: 0;
    width: 70px;
    float: left;
    margin-left: 05px;
    text-align: center;
}

.frnd-request .frnd-tltp {
    position: absolute;
    top: -1px;
    right: -2px;
    color: #fff;
    background-color: #fe1c69;
    font-size: 9px;
    border-radius: 50%;
    width: 15px;
    height: 16px;
    text-align: center;
    line-height: 15px;
}
a.frndr .ttl {
position: absolute;
    bottom: -10px;
    left: 0;
    width: 70px;
    text-align: center;
    color: #585353;
    font-size: 12px;
    text-transform: capitalize;
}
.frnd-request ul.requst-list {
    position: absolute;
    background-color: #fff;
    top: 56px;box-shadow: 0 3px 8px rgba(0, 0, 0, .25);
    margin: 0;min-width: 350px;
    display: none;
    right: -15px;
    border-radius: 4px;
}
.rquest-box a.rqst-img img{max-width: 40px;border-radius: 50%;}
.frnd-request ul.requst-list li {
    width: 100%;
    float: left;
    position: relative;
    min-height: 60px;border-bottom: solid 1px #e7e7e7;
}
.frnd-request ul.requst-list li:last-child {
    border: 0;
}
.rquest-box {
    width: 400px;
    float: left;
}
.rquest-box a.rqst-img {
    float: left;
    padding: 8px;
    left: 0;
    position: absolute;
}
.rquest-box .rqst-right {
    float: left;
    width: 100%;
    text-align: left;
    padding-left: 60px;
    padding-top: 7px;
}
.rqst-right a {
    display: block;
    font-size: 13px;
}

.rqst-right label {
    display: block;
    font-size: 11px;
    color: #979797;
}
.rqst-right a {
    display: inline-block;
    font-size: 13px;
}
.rquest-box .add-frnd {
    float: right;
    width: auto;
    padding-top: 0;
    margin-right: 9px;position: absolute;
    right: 0;
    margin-right: 9px;
    top: 10px;
}
.add-frnd a {
    background-color: #1c267a;
    color: #fff;
    padding: 3px 7px;
    text-decoration: none;
    text-transform: capitalize;
    border-radius: 4px;
    font-size: 12px;
    float: left;
}
.add-frnd a.dlt {
    background-color: #e7e7e7;
    color: #7c7c7c;
    margin-left: 5px;
}
ul.requst-list:after {
    position: absolute;
    content: '';
    right: 39px;
    top: -8px;
    width: 15px;
    z-index: -1;
    height: 15px;
    background-color: #ebebeb;
    transform: rotate(47deg);
    border-top: solid 1px #ccc;
    border-left: solid 1px #ccc;
}

.notice {
    float: left;
    width: 35px;
}
ul.requst-list .list-heding {
    display: block;
    background-color: #ebebeb;
    z-index: 9;
    padding: 6px 10px;
    border-bottom: solid 1px #e7e7e7;
}

ul.requst-list .fttr {
    width: 100%;
    text-align: center;
    float: left;
    padding: 5px;
}
.commnts-cont {
    float: left;
    width: 100%; border-top: solid 1px #e7e7e7;
}
ul.cmmnt-list{
    float: left;
    width: 100%;
    margin: 0;
}
.cmmnt {
    width: 100%;
    float: left;padding: 10px;padding-left: 0;
    position: relative;
}
ul.cmmnt-list li{    width: 100%;
    float: left;border-bottom: solid 1px #e7e7e7;}
.cmmnt img {
    float: left;
    max-width: 40px;
    margin-right: 10px;
    border-radius: 50%;
}

.cmmnt a.close {
    font-size: 14px;
}
ul.cmmnt-list li:last-child{border-bottom: 0;}
.cmmnt span {
    margin-left: 6px;    font-size: 12px;
    color: #3a3a3a;
}
.cmmnt .cmmnt-cntnt {
    float: right;
    width:90%;
}
.comnt-write {
    float: left;
    width: 100%;
    padding-top: 10px;
    padding-bottom: 5px;
}
.rquest-middle {
float: left;
   position: relative;
    width: 100%;
    padding-right: 125px;margin-bottom: 5px;
}
.write-cmnt-pic {
    float: left;
    max-width: 60px;
    margin-right: 10px;
}
.write-cmnt-pic img {
    max-width: 40px;
    border-radius: 50%
}
.cmnt-inpt {
    float: right;
    width: 91%;
    position: relative;
}
.cmnt-inpt button {
    background-color: #1c267a;
    border: 0;
    padding: 7px 10px;
    color: #fff;
    right: 3px;
    top: 3px;
    text-transform: capitalize;
    position: absolute;
    border-radius: 0 4px 4px 0;
}
.cmnt-inpt input {
    width: 100%;
    height: 35px;

/* Company Detail start*/
h2 {
    font-size: 20px;
    margin-top: 0;
    font-weight: 400;
    margin-bottom: 15px;
}
ul.employers-list {
    margin: 0;
    width: 100%;
    float: left;
    padding-right: 10px;
}
.compny {
    width: 100%;
    float: left;
    padding-left: 10px;
    padding-top: 10px;
}
ul.employers-list li{float: left;width: 100%;margin-bottom: 15px;}
.employers {
    float: left;
    width: 100%;
    border: solid 1px #e7e7e7;
    padding: 15px;  
    transition: 200ms;  
    border-radius: 4px;
}
.employers:hover {
    border-color: #dbdbdb;
    box-shadow: 1px 2px 6px 0 rgba(128,128,128,0.15);
    background-color: #fafafa;
}
.employers .comp-logo {
    max-width: 20%;overflow: hidden;
    text-align: center;
    float: left;width: 115px;
}   
.employers .comp-mddl {
float: right;
    width: 80%;
    padding-left: 20px;
}
.employers .comp-logo img {
    max-width: 100%;
    height: auto;
}
.comp-mddl .nm {
    display: block;
    font-size: 19px;
    color: #1c267a;
}

ul.employers-list.recomend li .employers {
    padding: 10px;
}
ul.employers-list.recomend li .employers .comp-logo {
width: 70px;
    min-width: inherit;
}
ul.employers-list.recomend li .employers .comp-mddl .catgr {
    height: 20px;
    display: block;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
}
ul.tmln_fttr li:nth-child(2),ul.tmln_fttr li:nth-child(2) a {
    cursor: inherit;
}
ul.tmln_fttr li:nth-child(2):hover{background-color: inherit;}
ul.tmln_fttr li:nth-child(2):hover a{color: #909090;}
ul.employers-list.recomend li .employers .comp-mddl a{    display: block;
    font-size: 19px;
    color: #1c267a;
    height: 25px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;}
ul.employers-list.recomend li .employers .comp-mddl {
    width: 73%;
    padding-left: 10px;
    box-sizing: border-box;
}
.comp-mddl .catgr {
    font-size: 14px;

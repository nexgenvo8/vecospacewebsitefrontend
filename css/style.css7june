.descrptn {
    width: 100%;
    background-color: #eaeaea;
    float: left;
    margin: auto;
    font-size: 18px;
    padding: 20px;
    position: relative;
    color: #515151;
    border-top: solid 1px #ccc;
}

.descrptn:before {
    position: absolute;
    content: '';
    top: -13px;
    left: 59px;
    width: 25px;
    height: 25px;
    background-color: #eaeaea;
    transform: rotate(45deg);
    border-top: solid 1px #ccc;
    border-left: solid 1px #ddd;
}
.descrptn textarea {
    width: 100%;
    margin: 10px 0; border: solid 1px #ccc;
    border-radius: 4px;
    font-family: arial;
    padding: 10px;
}
.descrptn button.cancel {
    background-color: #eaeaea;
    color: #fe1c69;
}
.descrptn button {
    float: right;
    background-color: #fe1c69;
    padding: 7px 15px;
    color: #fff;
    text-decoration: none;
    border: 0;
    border-radius: 4px;
}
ul.nav_list li a.edit_profile {
    display: block;
    font-size: 16px;
    line-height: inherit;
    overflow: hidden;display: block;position: relative;min-height: 65px;
    padding-left: 80px;
}
a.edit_profile:before {
    display: none;
}
a.edit_profile span.pf_pic {
    float: left;
    width: 65px;
    position: absolute;
    left:0;
}
a.edit_profile:hover {
    text-decoration: none;
}

li.prfl_li:hover a.edit_profile:before{display: none;}
a.edit_profile:hover span.pf-name {
    text-decoration: underline;
}

a.edit_profile span.pf-name {
    display: block;
    font-size: 16px;
    color: #fe1c69;
}
a.edit_profile label {
    border: 1px solid #202d78;
    border-radius: 2px;
    display: inline-block;
    font-size: 12px;
    cursor: pointer;
    margin-top: 8px;
    color: #000;
    padding: 2px 7px;
    text-transform: capitalize;
}
a.edit_profile label.mobile_lbl {
    display: none;
}

ul.nav_list li.prfl_li {
    padding:25px 15px !important;
}


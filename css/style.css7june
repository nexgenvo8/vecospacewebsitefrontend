    font-size: 16px;
}
.right-nwsbx p {
    font-size: 12px;
    margin-top: 5px;
}

.newsbx-img {
    width: 100%;
    float: left; padding-bottom: 10px;
    position: relative;
}
.newsbx-img a {
    display: block;
    text-align: center;
}
.newsbx-img a img {
    max-width: 100%;
    display: block;
    position: relative;
    margin: auto;
    max-height: 96px;
}
.newsbx-img .ttl {
    position: absolute;
    bottom: 0;
    background-color: rgba(0,0,0,0.5);
    display: block;
    width: 100%;
    text-align: left;
    left: 0;
    color: #fff;
    margin-bottom: 0;

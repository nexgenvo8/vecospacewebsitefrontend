    margin-top: 0;
    position: relative;
    margin-left: 15px;
}
.toggle span.usr_img img {
    position: absolute;
    left: 50%;
    top: 50%;max-width: 30px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
}
.toggle span.usr_img {
    width: 32px;
    height: 32px;
    margin-top: 0;
    display: inline-block;
    text-align: center;
    border: solid 1px;
    position: relative;
    line-height: 40px;
    border-radius: 50%;
    background-image: url(../images/user-small.png);
    background-position: center;background-size: 20px;
    background-repeat: no-repeat;
}
.toggle a i.fa {
    float: right;

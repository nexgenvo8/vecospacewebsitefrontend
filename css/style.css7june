    margin-top: 25px;
    font-size: 18px;
}
.offline {
    width: 13px;
    height: 13px;
    background-color: #cecece;
    border-radius: 50%;
    position: absolute;
    right: 10px;
    top: 30px;
    border: solid 2px #fff;
}
.online {
    width: 13px;
    height: 13px;
    background-color: #00e800;
    border-radius: 50%;
    position: absolute;
    right: 10px;
    top: 30px;
    border: solid 2px #fff;
}
.chat-cont {
    width: 262px;
    position: fixed;
    right: 110px;
    bottom: 0px;
    background-color: #FFFFFF;
    z-index: 99999;border-radius: 4px 4px 0 0;
    box-shadow: 0px 0px 5px #a0a0a0;
}
#usermainboxchat {
    z-index: 99999;
}
#msgchat .heddr a.im {
    display: block;
    width: 43px;
    height: 40px;
    z-index: 99;
    text-align: center;
    float: left;
    position: absolute;
}
#msgchat .heddr a.im img {
    position: inherit !important;
    float: left;
    left: 8px;
    max-width: 25px;
    top: 8px;
}
.chat-cont-header {
    padding: 10px;
    font-size: 15px;
    border-radius: 4px;
    cursor: pointer;
    box-shadow:0px 2px 5px #d1d1d1;margin-bottom: 4px;
}
.chat-cont-header:hover {

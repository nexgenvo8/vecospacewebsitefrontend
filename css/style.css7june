/* Company page end*/































@media (max-width: 1024px) {

.header_right{width: 80%;}
.left_menu_sec{min-width: 190px;}
.center_content{max-width: 745px;}



.hdr_search {
    float: right;
    width: 60%;
}
.mainsearch{width: 280px;}
.mainsearch input.text{width: 100%}
.left_prgrs_sec {
    width: 33%;
}
.nav-cont .column{width: 19%;}
.prgrs_steps ul{width: 100%;}

.layered-bg {
    background: url(../images/banner_frm_bg.png) -210px top no-repeat transparent;}
    .form_cont {
    padding: 35px 10px 10px;}
   .communication-container-b{width: 390px;}
   .communication-container-b h1 {
    color: #fdfeff;
    font-size: 27px;}

.form_cont{left: 40px;}
.nav-cont .column{height: 270px;margin-bottom: 50px;}

}


@media (max-width: 800px) {
	.layered-bg{background: #212d6e;}
	.communication-container-b{display: none;}
.nav-cont .column{width: 33.33%;}
	.form_cont {
    left: 50%;
    transform: translateX(-50%);
}
.header_right{width: 75%;}
header{padding:5px 0;}
.search_drop{display: none;}
.hdr_search{width: 70%;}
.find_btn{display: none;}
.left_prgrs_sec{display: none;}
.prgrs_steps{width: 100%;}
.center_content {
    width: 90%;
    float: right;
    padding-right: 0;
}
.hm_right_sec{display: none;}
.mainsearch{float: left;}





}   /*1024px*/

@media (max-width: 768px) {
.nav-cont .column{width: 100%;
margin: auto;
clear: both;
height: 230px;
margin-bottom: 50px;
margin-left: 20px;
margin-right: 20px;}
.contct_search form input{width: 100%;margin-bottom: 5px;padding-left: 10px;}
.center_content{width: 90%;}
ul.nav_list li a i.micon{padding-left: 20px;}
.hiden-d{display: block !important;}
.hiden-xs{display: none !important;}
.toggle{float: right;}
.mainsearch input.text {
    width: 17%;
    float: right;
    transition: 300ms;
}
.mainsearch input.text:focus {
    width: 100%;
}





}


@media (max-width: 640px) {
	header{padding: 0 15px;}
	.header_right {
    float: right;
    width: auto;
}
.logo a img {
    width: 110px;
}
.email_center h1 {
    font-size: 20px;
    max-width: 520px;}
.form_cont{width: 250px;}

.nav-cont{padding-bottom: 0;float: none;}
.contct_search form button{width: 100px;}
.mmbr_directory span,ul.people-directory{float: none; display: block;width: 100%;text-align:center; }
dl.dl_list dt{display: block;}

}

.updt_frfl {
    width: 100%;
    float: left;
    background-color: #fff;
    padding: 20px;
}

ul.tmln_fttr li { 
   padding: 5px 13px;
}

ul.tmln_fttr li a .tltp {
   display: inline-block;
   padding: 3px 5px;
   position: absolute;
   color: #1c267a;
   font-size: 9px;
   border-radius: 50%;
   margin-left: 5px;
   text-align: center;
   right: 0;
   font-size: 11px;
   top: 5px;
}


ul.tmln_fttr { 
   padding-left: 0px !important;    padding-bottom: 0px !important;
}

ul.tmln_fttr li { 
   border: 1px #efefef solid; cursor:pointer;
}

ul.tmln_fttr li:hover{background-color: #d0d0d0}
ul.tmln_fttr li:hover a{color: #252525;}


































































































